{
  "schema_version": 1,
  "description": "Gates de produto pendentes falham explicitamente até a implementação dos testes. Comandos são arrays argv sem shell e devem falhar se nenhum teste executar.",
  "gates": {
    "compatibility": {"command": ["cargo", "test", "--locked", "--test", "compatibility", "--", "--ignored", "--exact", "release_compatibility_gate", "--nocapture"], "timeout_seconds": 600},
    "crash": {"command": ["cargo", "test", "--locked", "--test", "persistence", "--", "--ignored", "--exact", "release_crash_gate", "--nocapture"], "timeout_seconds": 600},
    "recovery": {"command": ["cargo", "test", "--locked", "--test", "persistence", "--", "--ignored", "--exact", "release_recovery_gate", "--nocapture"], "timeout_seconds": 600},
    "migration": {"command": ["cargo", "test", "--locked", "--test", "persistence", "--", "--ignored", "--exact", "release_migration_gate", "--nocapture"], "timeout_seconds": 600},
    "sharding": {"command": ["cargo", "test", "--locked", "--test", "sharding", "--", "--ignored", "--exact", "release_sharding_gate", "--nocapture"], "timeout_seconds": 600},
    "types": {"command": ["cargo", "test", "--locked", "--test", "collections_differential", "--", "--ignored", "--exact", "release_types_gate", "--nocapture"], "timeout_seconds": 600},
    "sorted_sets": {"command": ["cargo", "test", "--locked", "--test", "collections_differential", "--", "--ignored", "--exact", "release_sorted_sets_gate", "--nocapture"], "timeout_seconds": 600},
    "transactions": {"command": ["cargo", "test", "--locked", "--test", "transactions", "--", "--ignored", "--exact", "release_transactions_gate", "--nocapture"], "timeout_seconds": 600},
    "pubsub": {"command": ["cargo", "test", "--locked", "--test", "pubsub", "--", "--ignored", "--exact", "release_pubsub_gate", "--nocapture"], "timeout_seconds": 600},
    "replication": {"command": null, "timeout_seconds": 1200},
    "docker": {"command": ["cargo", "test", "--locked", "--test", "docker_distribution", "--", "--ignored", "--exact", "release_docker_gate", "--nocapture"], "timeout_seconds": 1200},
    "soak": {"command": null, "timeout_seconds": 3900, "minimum_seconds": 3600},
    "benchmarks": {"command": null, "timeout_seconds": 1800}
  }
}
